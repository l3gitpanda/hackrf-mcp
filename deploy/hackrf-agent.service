# systemd unit for hackrf-agent (src/hackrf_mcp/agent.py), the half of a
# split station that runs where the HackRF is plugged in: it owns the device
# and streams its samples to a worker on another machine, whose live service
# has HACKRF_LIVE_AGENT=<this host>:<port> and the same token.
#
# Install:
#   sudo cp deploy/hackrf-agent.service /etc/systemd/system/
#   sudo systemctl edit hackrf-agent     # set User=/Group= to hackrf-mcp's
#   (put the settings below in /etc/hackrf-mcp/agent.env, mode 0640)
#   sudo systemctl daemon-reload && sudo systemctl enable --now hackrf-agent
#
# /etc/hackrf-mcp/agent.env:
#   HACKRF_AGENT_HOST=0.0.0.0
#   HACKRF_AGENT_PORT=8767
#   HACKRF_AGENT_ALLOW=192.0.2.10            # the worker, and nothing else
#   HACKRF_AGENT_TOKEN_FILE=/etc/hackrf-mcp/agent-token   # or ..._TOKEN_SHA256
#   HACKRF_AGENT_MAX_CAPTURE_MB=2048         # largest capture it will run
#   HACKRF_AGENT_ALLOW_BIAS_TEE=off          # DC on the antenna port
#   HACKRF_AGENT_TOOLS_DIR=/usr/local/bin    # hackrf_info and hackrf_sweep
#   HACKRF_AGENT_FALLBACK_LIVE_DIR=/var/lib/hackrf-mcp/live   # see below
#   HACKRF_AGENT_FALLBACK_AFTER_S=120        # no worker for this long: decode here
#
# Allow the port in the firewall for the worker's address only: there is
# no TLS, and the samples carry everything the radio hears.
#
# One HackRF. A hackrf-live on this machine can stay as the fallback: with
# HACKRF_AGENT_FALLBACK_LIVE_DIR set to its HACKRF_LIVE_DIR, the agent keeps
# it paused while a worker is around (streaming, running a tool, or sending
# its heartbeat) and lets it decode on its own when none has been seen for
# HACKRF_AGENT_FALLBACK_AFTER_S; the worker imports what it logged. That
# hackrf-live must NOT have HACKRF_LIVE_AGENT set: it opens this machine's
# HackRF itself. Without the setting, don't run a hackrf-live here at all.

[Unit]
Description=hackrf-agent (the HackRF's samples for a worker elsewhere)
After=network.target

[Service]
Type=simple
User=hackrf
Group=hackrf
SupplementaryGroups=plugdev
EnvironmentFile=/etc/hackrf-mcp/agent.env
# The fallback reads the local live log; SQLite needs its shared-memory
# file writable for that even read-only. Ignored when the path is missing.
ReadWritePaths=-/var/lib/hackrf-mcp/live
ExecStart=/opt/hackrf-mcp/.venv/bin/python -m hackrf_mcp.agent
Restart=always
RestartSec=5

# hackrf_transfer and the copy to the network; no decoding happens here.
MemoryHigh=96M
MemoryMax=160M
CPUQuota=100%
Nice=-2
LogRateLimitIntervalSec=60
LogRateLimitBurst=200

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
