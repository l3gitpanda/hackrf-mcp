# /etc/hackrf-mcp/env -- read by deploy/hackrf-mcp.service.
# Keep it root-owned, mode 0640, group = the service's group.

# Network endpoint: http://<host>:<port>/mcp
HACKRF_MCP_HOST=0.0.0.0
HACKRF_MCP_PORT=8765

# Bearer token clients must send. Generate it on the server, e.g.:
#   sudo sh -c 'umask 027; openssl rand -hex 32 > /etc/hackrf-mcp/token'
#   sudo chgrp <service group> /etc/hackrf-mcp/token
HACKRF_MCP_TOKEN_FILE=/etc/hackrf-mcp/token
# Further accepted tokens, as SHA-256 hex digests (comma-separated), so a
# client can generate its own token and hand over only the digest:
#   printf %s "$(cat client.token)" | sha256sum
#HACKRF_MCP_TOKEN_SHA256=

HACKRF_MCP_DATA_DIR=/var/lib/hackrf-mcp/captures
HACKRF_MCP_TX_LOG=/var/lib/hackrf-mcp/tx-audit.jsonl

# Transmit mode: off | allowed-bands | unrestricted
HACKRF_MCP_TX_MODE=off
# Band sets allowed-bands permits: ism, amateur (comma-separated)
HACKRF_MCP_TX_BANDS=ism
# Extra allowed ranges in MHz, e.g. 433.05-434.79
#HACKRF_MCP_TX_EXTRA_RANGES=
# JSON file adding or overriding band sets: {"sets": {"name": [[low_mhz, high_mhz, "label"]]}}
#HACKRF_MCP_BANDS_FILE=

# Bias-tee DC power on the antenna port: refused unless true
#HACKRF_MCP_ALLOW_BIAS_TEE=false

# Limits
#HACKRF_MCP_MAX_RX_SECONDS=60
#HACKRF_MCP_MAX_CAPTURE_MB=2048
#HACKRF_MCP_MIN_FREE_MB=2048
#HACKRF_MCP_MAX_TX_SECONDS=60

# Live decoding (deploy/hackrf-live.service). Both services read this file,
# so the directory set here is where hackrf-mcp finds the live service's
# socket and log.
HACKRF_LIVE_DIR=/var/lib/hackrf-mcp/live
#HACKRF_LIVE_MAX_AGE_DAYS=7
#HACKRF_LIVE_MAX_DB_MB=256
# Pager (FLEX/POCSAG) message text is logged by hackrf-live, and shown or
# saved by hackrf_decode, only if true; otherwise only time, channel,
# capcode and message type are. (HACKRF_LIVE_PAGER_CONTENT also works.)
#HACKRF_MCP_PAGER_CONTENT=false
# Receiver position as LAT,LON, so dump1090 can resolve more positions.
#HACKRF_LIVE_RECEIVER=
#HACKRF_LIVE_LNA_GAIN=32
#HACKRF_LIVE_VGA_GAIN=40

# FastMCP checks PyPI for a newer FastMCP at every start and prints a
# banner; neither is useful for a service.
FASTMCP_CHECK_FOR_UPDATES=off
FASTMCP_SHOW_SERVER_BANNER=false
