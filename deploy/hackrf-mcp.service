# systemd unit for running hackrf-mcp as a network service.
#
# Install:
#   sudo cp deploy/hackrf-mcp.service /etc/systemd/system/
#   sudo systemctl edit hackrf-mcp      # set User=/Group= (see below)
#   sudo systemctl daemon-reload && sudo systemctl enable --now hackrf-mcp
#
# The user needs read/write access to the HackRF's USB device; with the
# distribution's hackrf udev rules that means membership of the plugdev
# group. Captures and the transmit audit log go to /var/lib/hackrf-mcp.

[Unit]
Description=hackrf-mcp (MCP server for a HackRF SDR, streamable HTTP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hackrf
Group=hackrf
SupplementaryGroups=plugdev
EnvironmentFile=/etc/hackrf-mcp/env
Environment=MPLCONFIGDIR=/var/cache/hackrf-mcp
ExecStart=/opt/hackrf-mcp/.venv/bin/hackrf-mcp --transport http
Restart=on-failure
RestartSec=5

StateDirectory=hackrf-mcp
CacheDirectory=hackrf-mcp
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
