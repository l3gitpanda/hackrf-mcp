# Settings for the split station's worker (deploy/worker/compose.yaml).
# Secrets are SHA-256 digests or files, never tokens in this file.

# Not here: HACKRF_LIVE_AGENT. compose.yaml sets it, with the token file, for
# the live and mcp services only; in this shared file it would reach web too,
# which then refuses to start without a token file.

# Where the receiver is, for dump1090 and the map's range rings (rounded).
# HACKRF_LIVE_RECEIVER=LAT,LON

HACKRF_LIVE_SPECTRUM_MAX_MB=1536

# Web UI: digests of the accepted tokens (comma-separated).
HACKRF_WEB_TOKEN_SHA256=

# MCP server: digests of the accepted bearer tokens.
HACKRF_MCP_TOKEN_SHA256=

# Pager message text is not logged unless this is on.
# HACKRF_MCP_PAGER_CONTENT=off
